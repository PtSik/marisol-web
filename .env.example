# Copy to .dev.vars for Worker development; leave secrets out of Git.
# Resource bindings (KV, D1, service binding) are configured in wrangler.jsonc.
# Use isolated development resources and credentials, not the production defaults.

# ElevenLabs API key
ELEVENLABS_API_KEY=

# Demo line phone number
NEXT_PUBLIC_DEMO_PHONE=

# Team phone number
NEXT_PUBLIC_TEAM_PHONE=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Use Stripe test prices in a development environment.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_COMPLETE_MONTHLY=
STRIPE_PRICE_COMPLETE_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_EXTRA_LOCATION_MONTHLY=
STRIPE_PRICE_EXTRA_LOCATION_ANNUAL=
STRIPE_REFERRAL_COUPON=

RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
RESEND_FROM=
CLIENT_EMAIL_FROM=

# Operator-reviewed provisioning: use a development voice-agent API and test accounts.
ADMIN_API_KEY=
VOICE_AGENT_API_URL=http://localhost:8787
BARBER_AGENT_ID=
GROOMING_AGENT_ID=
ONBOARDING_PREVIEW_AGENT_ID=
# Twilio account that owns the numbers (same account as voice-agent) — buys local numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# /admin dashboard password (separate from ADMIN_API_KEY on purpose)
ADMIN_DASH_KEY=

# Outreach (scripts/make-drafts.ts, local only — set in .env.local, not a Worker secret)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
LEADS_SPREADSHEET_ID=
OUTREACH_FROM_NAME=
OUTREACH_POSTAL_ADDRESS=

# Authentication and browser-demo webhooks
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
SALES_DASH_KEY=
# Leave the cookie domain unset for localhost.
COOKIE_DOMAIN=
COOKIE_PREFIX=local_
