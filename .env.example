# ElevenLabs API key
ELEVENLABS_API_KEY=

# Demo line phone number
NEXT_PUBLIC_DEMO_PHONE=

# Team phone mumber
NEXT_PUBLIC_TEAM_PHONE=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
RESEND_FROM=
CLIENT_EMAIL_FROM=
# Optional: Google service-account email clients share their calendar with
GCAL_SHARE_EMAIL=

# Auto-provisioning: voice-agent admin API (one of its ADMIN_API_KEYS) + grooming agent
ADMIN_API_KEY=
GROOMING_AGENT_ID=
# Twilio account that owns the numbers (same account as voice-agent) — buys local numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# /admin dashboard password (separate from ADMIN_API_KEY on purpose)
ADMIN_DASH_KEY=

# Outreach (scripts/make-drafts.ts, local only — set in .env.local, not a Worker secret)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
LEADS_SPREADSHEET_ID=
OUTREACH_FROM_NAME=
OUTREACH_POSTAL_ADDRESS=
