{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaijiro-landing",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/launch.ts",
  "triggers": { "crons": ["* * * * *"] },
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "callmarisol.com", "custom_domain": true },
    { "pattern": "www.callmarisol.com", "custom_domain": true },
    { "pattern": "app.callmarisol.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "63226420204e48b7bc152b561d5f05de"
    },
    {
      "binding": "LEADS_KV",
      "id": "cfc515ef0b784a4396df923908792bb7"
    }
  ],
  "d1_databases": [
    {
      "binding": "OUTREACH_DB",
      "database_name": "marisol-outreach",
      "database_id": "df37b1e3-ff67-4842-b2db-c5cd2b949b88",
      "migrations_dir": "d1/migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "FUNNEL_AE",
      "dataset": "kaijiro_funnel"
    }
  ],
  "services": [
    {
      "binding": "VOICE_AGENT_API",
      "service": "voice-agent-api"
    }
  ],
  "vars": {
    "VOICE_AGENT_API_URL": "https://voice-agent-api.patrykgniewek9.workers.dev",
    "STRIPE_PRICE_BASIC_MONTHLY": "price_1TzG5B8DgPA5sdCxq7KZXQ5i",
    "STRIPE_PRICE_BASIC_ANNUAL": "price_1TzG5B8DgPA5sdCxYbBK9dzp",
    "STRIPE_PRICE_COMPLETE_MONTHLY": "price_1TzBYY8DgPA5sdCxCFeUMtHP",
    "STRIPE_PRICE_COMPLETE_ANNUAL": "price_1TzBYY8DgPA5sdCxDz2XaPa9",
    "STRIPE_PRICE_GROWTH_MONTHLY": "price_1TzBYY8DgPA5sdCx6wY10pVQ",
    "STRIPE_PRICE_GROWTH_ANNUAL": "price_1TzBYZ8DgPA5sdCxhDjNGGTB",
    "STRIPE_PRICE_EXTRA_LOCATION_MONTHLY": "price_1TzGac8DgPA5sdCxsFmWDOaQ",
    "STRIPE_PRICE_EXTRA_LOCATION_ANNUAL": "price_1TzGad8DgPA5sdCxfihRvH8m",
    "RESEND_FROM": "Marisol Leads <leads@getmarisol.com>",
    "CLIENT_EMAIL_FROM": "Marisol <hello@getmarisol.com>",
    "GROOMING_AGENT_ID": "agent_2501ktmhtm2wf8789jqdtkbj7jdr",
    // Pinned per vertical so provisioning never leans on voice-agent's ELEVENLABS_TEMPLATE_AGENT_ID
    // fallback, which quietly handed every non-grooming shop the barber agent.
    "BARBER_AGENT_ID": "agent_8301ks8brwmbedw8nv1sgnwwcdfw",
    // Demo pool runs on the grooming DEMO clone, never the client agent, so prompt tuning for
    // sales cannot reach a paying shop. Leave the ES id empty until a Spanish-opening clone
    // exists — the pool falls back to the English one, which still switches mid-call.
    "DEMO_POOL_AGENT_ID": "agent_3801kx681qx9e199h4skk2139rz2",
    "DEMO_POOL_AGENT_ID_ES": "",
    "GCAL_SHARE_EMAIL": "bookings@marisol-voice.iam.gserviceaccount.com",
    // 10%-off, duration=once coupon that referred clients redeem via their referrer's code.
    "STRIPE_REFERRAL_COUPON": "marisol_referral_10off",
    // Session cookie is shared across the apex and app.callmarisol.com; unset on localhost dev.
    "COOKIE_DOMAIN": ".callmarisol.com"
  },
  "env": {
    "preview": {
      "triggers": { "crons": [] },
      "routes": [{ "pattern": "test.callmarisol.com", "custom_domain": true }],
      // Own namespaces, never production's: LEADS_KV is the client portal's store and the referral
      // ledger writes to it, so a preview deploy sharing it would edit live customer records.
      "kv_namespaces": [
        { "binding": "RATE_LIMIT_KV", "id": "ed787a950ffb4088a8e2e376861a085b" },
        { "binding": "LEADS_KV", "id": "ab23530cd4f6422688111f851037a1c6" }
      ],
      "d1_databases": [
        {
          "binding": "OUTREACH_DB",
          "database_name": "marisol-outreach-preview",
          "database_id": "efb170b9-28b6-444a-8c0e-6c3a4b26f207",
          "migrations_dir": "d1/migrations"
        }
      ],
      "analytics_engine_datasets": [
        { "binding": "FUNNEL_AE", "dataset": "kaijiro_funnel_preview" }
      ],
      "services": [{ "binding": "VOICE_AGENT_API", "service": "voice-agent-api" }],
      "vars": {
        "VOICE_AGENT_API_URL": "https://voice-agent-api.patrykgniewek9.workers.dev",
        "STRIPE_PRICE_BASIC_MONTHLY": "price_1TzG5B8DgPA5sdCxq7KZXQ5i",
        "STRIPE_PRICE_BASIC_ANNUAL": "price_1TzG5B8DgPA5sdCxYbBK9dzp",
        "STRIPE_PRICE_COMPLETE_MONTHLY": "price_1TzBYY8DgPA5sdCxCFeUMtHP",
        "STRIPE_PRICE_COMPLETE_ANNUAL": "price_1TzBYY8DgPA5sdCxDz2XaPa9",
        "STRIPE_PRICE_GROWTH_MONTHLY": "price_1TzBYY8DgPA5sdCx6wY10pVQ",
        "STRIPE_PRICE_GROWTH_ANNUAL": "price_1TzBYZ8DgPA5sdCxhDjNGGTB",
        "STRIPE_PRICE_EXTRA_LOCATION_MONTHLY": "price_1TzGac8DgPA5sdCxsFmWDOaQ",
        "STRIPE_PRICE_EXTRA_LOCATION_ANNUAL": "price_1TzGad8DgPA5sdCxfihRvH8m",
        "RESEND_FROM": "Marisol Leads <leads@getmarisol.com>",
        "CLIENT_EMAIL_FROM": "Marisol <hello@getmarisol.com>",
        "GROOMING_AGENT_ID": "agent_2501ktmhtm2wf8789jqdtkbj7jdr",
        "BARBER_AGENT_ID": "agent_8301ks8brwmbedw8nv1sgnwwcdfw",
        "DEMO_POOL_AGENT_ID": "agent_3801kx681qx9e199h4skk2139rz2",
        "DEMO_POOL_AGENT_ID_ES": "",
        "GCAL_SHARE_EMAIL": "bookings@marisol-voice.iam.gserviceaccount.com",
        "STRIPE_REFERRAL_COUPON": "marisol_referral_10off",
        // Scoped to the preview host so a session minted on test/ never travels to the apex or the
        // app.callmarisol.com dashboard. Production's own cookies still reach this host — hence the
        // distinct names, so the two can never be confused for one another.
        "COOKIE_DOMAIN": "test.callmarisol.com",
        "COOKIE_PREFIX": "preview_"
      }
    }
  }
}
