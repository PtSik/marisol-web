{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaijiro-landing",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "63226420204e48b7bc152b561d5f05de"
    },
    {
      "binding": "LEADS_KV",
      "id": "cfc515ef0b784a4396df923908792bb7"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "FUNNEL_AE",
      "dataset": "kaijiro_funnel"
    }
  ],
  "services": [
    {
      "binding": "VOICE_AGENT_API",
      "service": "voice-agent-api"
    }
  ],
  "vars": {
    "VOICE_AGENT_API_URL": "https://voice-agent-api.patrykgniewek9.workers.dev",
    "STRIPE_PRICE_MONTHLY": "price_1Tp7xrKMA6xjMEIA3IjSQBPA",
    "STRIPE_PRICE_ANNUAL": "price_1Tp7y0KMA6xjMEIAbfQIsVGP",
    "STRIPE_PRICE_PREMIUM_MONTHLY": "price_1TqseiKMA6xjMEIAHOCAWRof",
    "STRIPE_PRICE_PREMIUM_ANNUAL": "price_1TqsejKMA6xjMEIAhmz8Wyqk",
    "RESEND_FROM": "Kaijiro Leads <onboarding@resend.dev>"
  }
}
